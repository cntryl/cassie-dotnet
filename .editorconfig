root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_analyzer_diagnostic.severity = warning
dotnet_code_quality.CA1000.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1010.severity = none
dotnet_diagnostic.CA1065.severity = none
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.IDE0010.severity = none
dotnet_diagnostic.IDE0072.severity = none

[*.csproj]
indent_style = space
indent_size = 2

[*.{props,targets}]
indent_style = space
indent_size = 2

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = true

[test/**/*.cs]
conventions_test_naming_require_given = true
conventions_test_naming_require_when = true
dotnet_diagnostic.CA2007.severity = none
# xUnit requires public test, fixture, and base types.
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CNTRYL0001.severity = error
dotnet_diagnostic.CNTRYL0002.severity = error
