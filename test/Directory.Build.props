<Project>
  <Import Project="../Directory.Build.props"/>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <CassieTestingPlatformVersion>2.5.3</CassieTestingPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cntryl.Conventions.Testing.Analyzers" Version="1.0.1" PrivateAssets="all"/>
    <PackageReference Include="Cntryl.Conventions.Testing.CodeFixes" Version="1.0.1" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" Version="$(CassieTestingPlatformVersion)" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="$(CassieTestingPlatformVersion)" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="$(CassieTestingPlatformVersion)" PrivateAssets="all"/>
  </ItemGroup>
</Project>
